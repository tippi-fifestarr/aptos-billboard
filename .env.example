# Example environment variables for local development
# Copy this file to .env.local and fill in your values
#
# How to use:
#   cp .env.example .env.local
#   # then edit .env.local

# Indexer Configuration (Aptos Geomi No-Code Indexer)
# Example: https://api.testnet.aptoslabs.com/nocode/v1/api/XXXXXXXXXXXX/v1/graphql
NEXT_PUBLIC_INDEXER_API_URL=
# Bearer token for Indexer GraphQL
# Format: aptoslabs_XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_INDEXER_API_KEY=

# Gas Station Configuration (transaction sponsorship)
# Format: aptoslabs_XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_GAS_STATION_API_KEY=
